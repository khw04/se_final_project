SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pokemo
DB_USERNAME=pokemo
DB_PASSWORD=pokemo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 소셜 로그인 (OAuth) — 발급한 키만 채우면 해당 provider가 활성화됨
# Google: https://console.cloud.google.com (OAuth 클라이언트 ID, 승인된 리디렉션 URI 등록 필요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao: https://developers.kakao.com (REST API 키 = client-id, client-secret은 선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
