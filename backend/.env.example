SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pokemo
DB_USERNAME=pokemo
DB_PASSWORD=pokemo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-this-to-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8

# 소셜 로그인 (OAuth) - 발급한 키만 채우면 해당 provider가 활성화됨
# Google: https://console.cloud.google.com (OAuth 클라이언트 ID, 승인된 리디렉션 URI 등록 필요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao: https://developers.kakao.com (REST API 키 = client-id, client-secret은 선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 이메일 인증/비밀번호 재설정 메일. SMTP_ENABLED=false면 콘솔 mock 발송만 사용한다.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# 웹 푸시 VAPID 키. 비워두면 서버 시작 시 임시 키가 생성되어 재시작 후 기존 구독이 무효화된다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pokemo.dev

# 로컬 첨부파일 저장 경로. 운영 S3 연동 전까지 이 경로를 볼륨/백업 대상으로 관리한다.
LOCAL_UPLOAD_DIR=uploads
