# Copy this file to .env on the deploy server and fill in real secrets there.
# Do not commit the real .env file.

COMPOSE_PROJECT_NAME=pokemo

DB_NAME=pokemo
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=pokemo
DB_PASSWORD=pokemo
MYSQL_ROOT_PASSWORD=pokemo-root

JWT_SECRET=change-this-to-a-long-random-secret

# Frontend origin allowed by the backend in production, for example https://pokemo.example.com.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Set this only on the backend/deploy environment. Never expose it to frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8

# Social login. Fill these only when each provider is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Email verification / password reset sender. If SMTP_ENABLED is not "true",
# codes are only logged to the backend console (ConsoleEmailSender).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Web push VAPID keys. If empty, the backend creates temporary keys on startup,
# so existing browser push subscriptions become invalid after restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pokemo.dev

# Local attachment storage. Replace with S3 implementation/config in production.
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads

# Redis cache. Docker compose uses the redis service by default.
CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=10m

# S3 attachment storage. Set STORAGE_TYPE=s3 in production and provide AWS credentials
# through the runtime environment or instance role.
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PREFIX=attachments

# Production MySQL/RDS options.
DB_SSL_MODE=VERIFY_IDENTITY
# First empty DB deploy can use update. After schema is created, switch back to validate.
JPA_DDL_AUTO=validate
