# Copy this file to .env on the deploy server and fill in real secrets there.
# Do not commit the real .env file.

COMPOSE_PROJECT_NAME=pokemo

DB_NAME=pokemo
DB_USERNAME=pokemo
DB_PASSWORD=pokemo
MYSQL_ROOT_PASSWORD=pokemo-root

JWT_SECRET=change-this-to-a-long-random-secret

# Set this only on the backend/deploy environment. Never expose it to frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Deploy (Oracle Cloud VM) ---
# Public port the frontend (nginx) is served on. Use 80 on the VM.
FRONTEND_PORT=80
# Browser origin(s) allowed to call the API. Set to the VM public IP / domain.
# e.g. http://123.45.67.89  or  http://your-domain.com
CORS_ALLOWED_ORIGINS=http://CHANGE_TO_VM_PUBLIC_IP

# OAuth (fill if Google/Kakao login is used in deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
