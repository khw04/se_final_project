# Copy this file to .env on the deploy server and fill in real secrets there.
# Do not commit the real .env file.

COMPOSE_PROJECT_NAME=pokemo

DB_NAME=pokemo
DB_USERNAME=pokemo
DB_PASSWORD=pokemo
MYSQL_ROOT_PASSWORD=pokemo-root

JWT_SECRET=change-this-to-a-long-random-secret

# Set this only on the backend/deploy environment. Never expose it to frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Email verification / password reset sender. If SMTP_ENABLED is not "true",
# codes are only logged to the backend console (ConsoleEmailSender).
SMTP_ENABLED=false
SMTP_USERNAME=
SMTP_PASSWORD=
